# Records the ~19 s promo of the cat: vhs film.tape
# The GIF goes into the README; the mp4 stays local (gitignored).
Output assets/video/pspsps-promo.gif
Output assets/video/pspsps-promo.mp4

Set Shell bash
Set FontSize 14
Set LineHeight 1.28
Set Width 1280
Set Height 720
Set Padding 0
Set Framerate 25
Set TypingSpeed 0
Set Theme { "name": "pspsps", "background": "#1e1e2e", "foreground": "#cdd6f4", "cursor": "#1e1e2e", "selection": "#45475a", "black": "#45475a", "red": "#f38ba8", "green": "#a6e3a1", "yellow": "#f9e2af", "blue": "#89b4fa", "magenta": "#f5c2e7", "cyan": "#94e2d5", "white": "#bac2de", "brightBlack": "#585b70", "brightRed": "#f38ba8", "brightGreen": "#a6e3a1", "brightYellow": "#f9e2af", "brightBlue": "#89b4fa", "brightMagenta": "#f5c2e7", "brightCyan": "#94e2d5", "brightWhite": "#a6adc8" }

Hide
Type "./psspss film"
Enter
Sleep 300ms
Show
Wait+Screen@60s /lives on your screen/
Sleep 3.4s
